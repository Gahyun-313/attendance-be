# 컨테이너(Docker/AWS) 실행 시 필요한 환경변수 예시.
# 실제 값을 채운 .env는 절대 커밋하지 말 것 (.gitignore에 .env 추가 필요 - 로컬에서 확인).
# 이 파일(.env.example)은 플레이스홀더만 있는 템플릿이라 커밋해도 안전함.
#
# docker-compose.yml이 이 파일을 그대로 복사한 실제 .env를 두 가지 용도로 읽는다:
# (1) app 서비스 컨테이너 안 환경변수로 그대로 주입 (env_file)
# (2) docker-compose.yml 자체의 ${DB_PASSWORD} 같은 표현식 치환 (MySQL 컨테이너의
#     MYSQL_ROOT_PASSWORD 등) - docker compose가 같은 폴더의 .env를 자동으로 읽어준다.
# DB_HOST=mysql / REDIS_HOST=redis는 docker-compose 안에서 쓸 값 그대로다 - 컴포즈
# 네트워크에서는 서비스 이름이 곧 호스트 이름이 된다.

DB_HOST=mysql
DB_PORT=3306
DB_NAME=attendance
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379

# 최소 256비트(32자) 이상 권장. 절대 예시 값 그대로 쓰지 말 것.
JWT_SECRET=change-me-to-a-real-secret-key

CORS_ALLOWED_ORIGINS=http://localhost:3000