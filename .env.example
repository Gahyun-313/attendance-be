# 컨테이너(Docker/AWS) 실행 시 필요한 환경변수 예시.
# 실제 값을 채운 .env는 절대 커밋하지 말 것 (.gitignore에 .env 추가 필요 - 로컬에서 확인).
# 이 파일(.env.example)은 플레이스홀더만 있는 템플릿이라 커밋해도 안전함.

DB_HOST=mysql
DB_PORT=3306
DB_NAME=attendance
DB_USERNAME=root
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379

# 최소 256비트(32자) 이상 권장. 절대 예시 값 그대로 쓰지 말 것.
JWT_SECRET=change-me-to-a-real-secret-key

CORS_ALLOWED_ORIGINS=http://localhost:3000