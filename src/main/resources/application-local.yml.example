# 로컬 개발 환경 설정 예시

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/attendance_db?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: your_mysql_password  # 본인의 MySQL 비밀번호로 변경

  data:
    redis:
      host: localhost
      port: 6379

jwt:
  secret: your-secret-key-min-256-bits-please-change-this
  access-token-expiration: 3600000
  refresh-token-expiration: 604800000

cors:
  allowed-origins: http://localhost:3000,http://localhost:5173